<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/video_card_background"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView android:id="@+id/video_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/pp_text_primary" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/video_category" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/category_chip_background" android:paddingStart="10dp" android:paddingTop="4dp" android:paddingEnd="10dp" android:paddingBottom="4dp" android:textColor="@color/pp_accent" android:textSize="12sp" />
    <TextView android:id="@+id/video_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/pp_text_secondary" android:textSize="14sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/video_votes" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/pp_text_primary" android:textSize="13sp" />
        <TextView android:id="@+id/video_cta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/feed_open_watch" android:textColor="@color/pp_accent" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
