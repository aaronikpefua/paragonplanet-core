<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pp_background"
    android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingTop="20dp" android:paddingEnd="20dp" android:text="@string/screen_feed_title" android:textColor="@color/pp_text_primary" android:textSize="28sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingTop="6dp" android:paddingEnd="20dp" android:text="@string/feed_section_categories" android:textColor="@color/pp_text_secondary" android:textSize="14sp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/category_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipToPadding="false" android:overScrollMode="never" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingTop="10dp" android:paddingEnd="20dp" android:text="@string/feed_section_videos" android:textColor="@color/pp_text_secondary" android:textSize="14sp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/video_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:overScrollMode="never" android:padding="16dp" />
</LinearLayout>
